# Render backend
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=your-postgres-host;Port=5432;Database=matharchive;Username=matharchive;Password=replace-with-db-password;SSL Mode=Require;Trust Server Certificate=true
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-characters
Admin__Username=admin
Admin__PasswordHash=replace-with-password-hash
AllowedOrigins__0=https://your-vercel-app.vercel.app
FileStorage__RootPath=/app/storage/documents
OpenAI__ApiKey=
OpenAI__Model=
OpenAI__AnalysisTimeoutSeconds=60
OpenAI__MaximumPagesToAnalyze=3
OpenAI__MonthlyWarningLimitUsd=5
OpenAI__BlockRequestsWhenLimitReached=false
OpenAI__TelemetryRetentionDays=365
# OpenAI__Pricing__YOUR_MODEL__InputPerMillionTokensUsd=
# OpenAI__Pricing__YOUR_MODEL__OutputPerMillionTokensUsd=

# Vercel frontend
VITE_API_BASE_URL=https://your-render-api.onrender.com

# Optional student assistant. Keep disabled until pricing, indexing and review are complete.
# Public student access only. RAG preparation can run with Enabled=false and RagEnabled=true.
Assistant__Enabled=false
# Paid indexing and corpus retrieval; enable after configuring OCR/embedding prices and budgets.
# To stop all assistant/RAG paid work, disable BOTH switches. Saved admin settings override defaults.
Assistant__RagEnabled=false
Assistant__EmbeddingModel=text-embedding-3-small
Assistant__DailyBudgetUsd=1
Assistant__MaxRequestCostUsd=0.05
# Supply current embedding input pricing before enabling; output pricing is zero.
# Pricing__text-embedding-3-small__InputPerMillionTokensUsd=replace-with-current-rate
# Pricing__text-embedding-3-small__OutputPerMillionTokensUsd=0
# Role-specific models are optional; blank values reuse OpenAI__Model.
# Assistant__TutorModel=
# Assistant__ExerciseModel=
# Assistant__VerifierModel=
# Assistant__RouterModel=
# Assistant__VisionModel=gpt-4o-mini
# RAG-enabled image indexing uses paid OCR automatically, including ordinary reindex.
# Configure input/output pricing for the exact VisionModel too.
