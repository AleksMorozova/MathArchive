# Render backend
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=your-postgres-host;Port=5432;Database=matharchive;Username=matharchive;Password=replace-with-db-password;SSL Mode=Require;Trust Server Certificate=true
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-characters
Admin__Username=admin
Admin__PasswordHash=replace-with-password-hash
AllowedOrigins__0=https://your-vercel-app.vercel.app
FileStorage__RootPath=/app/storage/documents

# Vercel frontend
VITE_API_BASE_URL=https://your-render-api.onrender.com
